# Example only. The installer collects the actual URL/token and writes user pip.ini.
# Windows user location: %APPDATA%/pip/pip.ini
# Authenticated URLs store tokens in plain text. Do not commit real credentials.
[global]
index-url = https://USERNAME:TOKEN@artifactory.example.com/artifactory/api/pypi/python-virtual/simple
extra-index-url =
find-links =
disable-pip-version-check = true
# cert = C:/OrgCertificates/corporate-ca.pem

[install]
index-url = https://USERNAME:TOKEN@artifactory.example.com/artifactory/api/pypi/python-virtual/simple
extra-index-url =
find-links =
